# PolarDB test environment example.
#
# Copy to test/polardb/.env or set POLARDB_ENV_FILE=/path/to/env before running
# PolarDB tests. Do not commit the real .env file.

# Test backend profile: docker or host.
POLARDB_TEST_ENV=host

# Preferred topology contract: list every direct PolarDB endpoint. The harness
# probes pg_is_in_recovery() and selects the single writer plus the first reader.
POLARDB_AUTODETECT=1
POLARDB_ENDPOINTS="<writer-host>:<writer-port> <reader-host>:<reader-port>"

# Manual topology override. Use only when autodetection is disabled or when the
# environment requires a specific reader.
# POLARDB_AUTODETECT=0
# PRIMARY_HOST=<writer-host>
# PRIMARY_PORT=<writer-port>
# REPLICA_HOST=<reader-host>
# REPLICA_PORT=<reader-port>
# POLARDB_SKIP_ROLE_CHECK=0

# ProxySQL endpoints used by integration tests.
PROXYSQL_HOST=127.0.0.1
PROXYSQL_PORT=16433
PROXYSQL_ADMIN_PORT=16132
PROXYSQL_MYSQL_ADMIN_PORT=16033
# PROXYSQL_BINARY=/path/to/proxysql

# ProxySQL topology IDs used by the PolarDB harness.
POLARDB_WRITER_HG=10
POLARDB_READER_HG=11
POLARDB_SELECT_RULE_ID=10000

# Database credentials through ProxySQL and direct to PolarDB.
PGDB=postgres
PGUSER=postgres
PGPASSWORD=postgres
PGUSER_DIRECT=postgres
PGPASSWORD_DIRECT=postgres
PGSSLMODE=disable

# DCS / cluster-control command used by replay-lag tests.
# For host/polarctl style environments:
POLARDB_DCS_MODE=polarctl
POLARDB_DCS_BIN=polarctl
POLARDB_DCS_SCOPE=<cluster-scope>
POLARDB_DCS_SUDO=0

# For docker style environments, use instead:
# POLARDB_TEST_ENV=docker
# POLARDB_DCS_MODE=docker
# POLARDB_DOCKER_BIN=docker
# POLARDB_DOCKER_CONTAINER=<container-name>
# POLARDB_DOCKER_SUDO=0
# POLARDB_ENDPOINTS="127.0.0.1:60432 127.0.0.1:60442 127.0.0.1:60452"

# Optional timeout/benchmark controls.
POLARDB_TIMEOUT_EDGE_TESTS=0
# PGBENCH_BIN=/path/to/pgbench  # Optional override; defaults to bundled PG16 pgbench.

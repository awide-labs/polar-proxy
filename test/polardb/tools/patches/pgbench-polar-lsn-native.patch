+ * Store the latest PolarDB RFQ LSN observed by patched libpq into pgbench
+ * variables.  The optional prefix keeps scripts readable:
+ *
+ *   \polar_lsn read
+ *
+ * creates :read_has_lsn and :read_lsn after the previous SQL command has
+ * completed.  This is intentionally explicit rather than automatic so scripts
+ * choose the boundary at which they want to assert session/transaction
+ * consistency.
+ */
+static bool
+polarStoreLSNVariable(CState *st, const char *prefix)
+{
+	char		has_name[128];
+	char		lsn_name[128];
+	char		has_value[2];
+	char		lsn_value[32];
+
+	if (prefix == NULL || *prefix == '\0')
+		prefix = "polar";
+
+	snprintf(has_name, sizeof(has_name), "%s_has_lsn", prefix);
+	snprintf(lsn_name, sizeof(lsn_name), "%s_lsn", prefix);
+	snprintf(has_value, sizeof(has_value), "%d", PQhasLSN(st->con) ? 1 : 0);
+	snprintf(lsn_value, sizeof(lsn_value), "%llu",
+			 (unsigned long long) PQgetLSN(st->con));
+
+	return putVariable(&st->variables, "polar_lsn", has_name, has_value) &&
+		putVariable(&st->variables, "polar_lsn", lsn_name, lsn_value);
+}
+

+
+/*
+ * PolarDB LSN API - for read-your-writes consistency
+ */
+
+/* PQgetLSN - get LSN from last ReadyForQuery (returns 0 if not available) */
+uint64_t
+PQgetLSN(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_last_lsn;
+}
+
+/* PQhasLSN - check if LSN is available from last ReadyForQuery */
+int
+PQhasLSN(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_has_lsn ? 1 : 0;
+}
+
+/* PQsetPolarSendLSN - enable/disable polar_proxy_send_lsn flag */
+void
+PQsetPolarSendLSN(PGconn *conn, int enable)
+{
+	if (!conn)
+		return;
+	conn->polar_proxy_send_lsn = (enable != 0);
+}
+
+/* PQgetReadyForQuerySequence - count of parsed ReadyForQuery messages */
+uint64_t
+PQgetReadyForQuerySequence(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_ready_sequence;
+}
+
+/*
+ * PolarDB Transaction Split API
+ */
+
+/* PQgetXactSplitXids - get transaction XIDs from last ReadyForQuery */
+const char *
+PQgetXactSplitXids(const PGconn *conn)
+{
+	if (!conn)
+		return NULL;
+	return conn->polar_xact_xids;
+}
+
+/* PQisXactSplittable - check if current transaction can be split ('x' marker) */
+int
+PQisXactSplittable(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_xact_splittable ? 1 : 0;
+}
+
+/* PQisXactWalPending - WAL not flushed but xids available ('w' marker) */
+int
+PQisXactWalPending(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_xact_wal_pending ? 1 : 0;
+}
+
+/* PQsetPolarSendXact - enable/disable polar_proxy_send_xact flag */
+void
+PQsetPolarSendXact(PGconn *conn, int enable)
+{
+	if (!conn)
+		return;
+	conn->polar_proxy_send_xact = (enable != 0);
+}

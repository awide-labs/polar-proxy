+/*
+ * psRowRunPending: cheap precheck for row-run detach.
+ *
+ * This does not validate the frame or prove that a full run is available. It
+ * only tells the caller that libpq is currently positioned at a DataRow frame,
+ * so the heavier peek/detach parser has useful work to do.
+ */
+int
+psRowRunPending(PGconn *conn)
+{
+	if (conn->asyncStatus != PGASYNC_BUSY)
+		return 0;
+	if (conn->result == NULL ||
+		conn->result->resultStatus != PGRES_TUPLES_OK)
+		return 0;
+	if (conn->inStart >= conn->inEnd)
+		return 0;
+	return conn->inBuffer[conn->inStart] == 'D';
+}
+
+/*
+ * psPeekRowRun: expose a contiguous run of complete DataRow ('D') frames.
+ * Release builds validate only the trusted PG frame envelope. Define
+ * POLARDB_LIBPQ_ROW_RUN_VALIDATE in diagnostic builds to also walk the DataRow
+ * payload and check field-count/value boundaries.
+ *
+ * Control frames stay on libpq's normal path, preserving command completion,
+ * ReadyForQuery, PolarDB RFQ LSN parsing, notices, and errors.
+ */
+int
+psPeekRowRun(PGconn *conn, const char **data, size_t *len, int *nframes, size_t budget)
+{
+	int			cur;
+	int			frames;
+	int			rc;
+
+	*data = NULL;
+	*len = 0;
+	*nframes = 0;
+
+	if (conn->asyncStatus != PGASYNC_BUSY)
+		return 1;
+	if (conn->result == NULL ||
+		conn->result->resultStatus != PGRES_TUPLES_OK)
+		return 1;
+
+	cur = conn->inStart;
+	frames = 0;
+	while (cur < conn->inEnd)
+	{
+		int			frame_len = 0;
+		size_t		next_len;
+
+		rc = psRowRunFrameAt(conn, cur, &frame_len);
+		if (rc != 0)
+			break;
+
+		next_len = (size_t) (cur + frame_len - conn->inStart);
+		if (budget > 0 && frames > 0 && next_len > budget)
+			break;
+
+		cur += frame_len;
+		frames++;
+	}
+
+	if (frames == 0)
+	{
+		if (conn->inStart < conn->inEnd && conn->inBuffer[conn->inStart] == 'D')
+		{
+			int			frame_len = 0;
+
+			rc = psRowRunFrameAt(conn, conn->inStart, &frame_len);
+			if (rc == EOF)
+				return EOF;
+		}
+		return 1;
+	}
+
+	*data = conn->inBuffer + conn->inStart;
+	*len = (size_t) (cur - conn->inStart);
+	*nframes = frames;
+	return 0;
+}
+
+void
+psAdvanceInput(PGconn *conn, size_t nbytes)
+{
+	int			avail;
+
+	if (nbytes == 0)
+		return;
+	avail = conn->inEnd - conn->inStart;
+	if (nbytes > (size_t) avail)
+		nbytes = (size_t) avail;
+	conn->inStart += (int) nbytes;
+	conn->inCursor = conn->inStart;
+}
+
+int
+psDetachRowRun(PGconn *conn, char **owned_buf, const char **data, size_t *len, int *nframes, size_t budget)
+{
+	const char *view = NULL;
+	size_t		view_len = 0;
+	int			frames = 0;
+	int			rc;
+	int			run_start;
+	int			run_end;
+	int			tail_len;
+	char	   *old_buf;
+	char	   *fresh_buf;
+
+	*owned_buf = NULL;
+	*data = NULL;
+	*len = 0;
+	*nframes = 0;
+
+	rc = psPeekRowRun(conn, &view, &view_len, &frames, budget);
+	if (rc != 0)
+		return rc;
+
+	run_start = conn->inStart;
+	run_end = run_start + (int) view_len;
+	tail_len = conn->inEnd - run_end;
+	if (tail_len < 0)
+		return 1;
+
+	fresh_buf = (char *) malloc(conn->inBufSize);
+	if (fresh_buf == NULL)
+		return 1;
+	if (tail_len > 0)
+		memcpy(fresh_buf, conn->inBuffer + run_end, tail_len);
+
+	old_buf = conn->inBuffer;
+	conn->inBuffer = fresh_buf;
+	conn->inStart = 0;
+	conn->inCursor = 0;
+	conn->inEnd = tail_len;
+
+	*owned_buf = old_buf;
+	*data = old_buf + run_start;
+	*len = view_len;
+	*nframes = frames;
+	return 0;
+}

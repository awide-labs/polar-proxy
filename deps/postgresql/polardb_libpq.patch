+/*
+ * PolarDB LSN API - for read-your-writes consistency
+ */
+
+/* PQgetLSN - get LSN from last ReadyForQuery (returns 0 if not available) */
+uint64_t
+PQgetLSN(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_last_lsn;
+}
+
+/* PQhasLSN - check if LSN is available from last ReadyForQuery */
+int
+PQhasLSN(const PGconn *conn)
+{
+	if (!conn)
+		return 0;
+	return conn->polar_has_lsn ? 1 : 0;
+}
+
+/* PQsetPolarSendLSN - enable/disable polar_proxy_send_lsn flag */
+void
+PQsetPolarSendLSN(PGconn *conn, int enable)
+{
+	if (!conn)
+		return;
+	conn->polar_proxy_send_lsn = (enable != 0);
+}
--- src/interfaces/libpq/fe-protocol3.c
+++ src/interfaces/libpq/fe-protocol3.c
@@ -1655,6 +1655,44 @@ getReadyForQuery(PGconn *conn)
 			break;
 	}
 
+	/*
+	 * Compute message end to avoid reading past boundary.
+	 * The length field (at inStart+1, 4 bytes, network order) includes itself
+	 * but not the type byte.  msg_end = inStart + 1 (type) + length_value.
+	 */
+	uint32		raw_len;
+	int			msg_end;
+
+	memcpy(&raw_len, conn->inBuffer + conn->inStart + 1, 4);
+	msg_end = conn->inStart + 1 + (int) pg_ntoh32(raw_len);
+
+#define MSG_REMAINING() (msg_end - conn->inCursor)
+
+	/* PolarDB extension: parse LSN if present */
+	conn->polar_has_lsn = false;
+	if (conn->polar_proxy_send_lsn && MSG_REMAINING() >= 8)
+	{
+		char lsn_buf[8];
+		if (pqGetnchar(lsn_buf, 8, conn) == 0)
+		{
+			uint64 lsn;
+			memcpy(&lsn, lsn_buf, 8);
+			lsn = pg_ntoh64(lsn);
+			conn->polar_last_lsn = lsn;
+			conn->polar_has_lsn = true;
+		}
+	}
+
+	/*
+	 * Skip any remaining bytes we did not parse.  This handles:
+	 *  - the backend appending extra fields the proxy did not request
+	 *  - Future PolarDB protocol extensions
+	 */
+	if (MSG_REMAINING() > 0)
+		conn->inCursor = msg_end;
+
+#undef MSG_REMAINING
+
 	return 0;
 }
 

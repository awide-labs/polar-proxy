+static void
+pqTraceOutputPolarWait(FILE *f, const char *message, int *cursor)
+{
+	uint16		flags;
+	uint32		timeout_ms;
+	uint64		target_lsn;
+	unsigned char version = message[(*cursor)++];
+	unsigned char mode = message[(*cursor)++];
+
+	memcpy(&flags, message + *cursor, sizeof(flags));
+	*cursor += sizeof(flags);
+	flags = pg_ntoh16(flags);
+	memcpy(&timeout_ms, message + *cursor, sizeof(timeout_ms));
+	*cursor += sizeof(timeout_ms);
+	timeout_ms = pg_ntoh32(timeout_ms);
+	memcpy(&target_lsn, message + *cursor, sizeof(target_lsn));
+	*cursor += sizeof(target_lsn);
+	target_lsn = pg_ntoh64(target_lsn);
+
+	fprintf(f,
+			"PolarWait\t version=%u mode=%u flags=%u timeout_ms=%u target_lsn=" UINT64_FORMAT,
+			version, mode, flags, timeout_ms, target_lsn);
+}

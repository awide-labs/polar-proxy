+static void
+pqSaveOutputBufferCheckpoint(PGconn *conn,
+							 struct pgOutputBufferCheckpoint *checkpoint)
+{
+	checkpoint->out_count = conn->outCount;
+	checkpoint->out_msg_start = conn->outMsgStart;
+	checkpoint->out_msg_end = conn->outMsgEnd;
+}
+
+static void
+pqRestoreOutputBufferCheckpoint(PGconn *conn,
+								const struct pgOutputBufferCheckpoint *checkpoint)
+{
+	conn->outCount = checkpoint->out_count;
+	conn->outMsgStart = checkpoint->out_msg_start;
+	conn->outMsgEnd = checkpoint->out_msg_end;
+}
+
+static int
+pqPutPolarWait(const struct pgPolarWaitSpec *wait_spec, PGconn *conn)
+{
+	if (!wait_spec)
+		return 0;
+	if (wait_spec->target_lsn == 0 ||
+		(wait_spec->consistency_mode != PQ_POLAR_CONSISTENCY_BEST_EFFORT &&
+		 wait_spec->consistency_mode != PQ_POLAR_CONSISTENCY_STRICT))
+	{
+		libpq_append_conn_error(conn, "invalid PolarDB proxy wait parameters");
+		return -1;
+	}
+
+	if (pqPutMsgStart('W', conn) < 0 ||
+		pqPutc(1, conn) < 0 ||
+		pqPutc(wait_spec->consistency_mode, conn) < 0 ||
+		pqPutInt(0, 2, conn) < 0 ||
+		pqPutInt((int) wait_spec->timeout_ms, 4, conn) < 0 ||
+		pqPutInt((int) (wait_spec->target_lsn >> 32), 4, conn) < 0 ||
+		pqPutInt((int) wait_spec->target_lsn, 4, conn) < 0 ||
+		pqPutMsgEndNoFlush(conn) < 0)
+		return -1;
+
+	return 0;
+}

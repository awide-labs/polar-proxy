@@ -1655,6 +1655,93 @@
 			break;
 	}
 
+	/*
+	 * Compute message end to avoid reading past boundary.
+	 * The length field (at inStart+1, 4 bytes, network order) includes itself
+	 * but not the type byte.  msg_end = inStart + 1 (type) + length_value.
+	 */
+	uint32		raw_len;
+	int			msg_end;
+
+	memcpy(&raw_len, conn->inBuffer + conn->inStart + 1, 4);
+	msg_end = conn->inStart + 1 + (int) pg_ntoh32(raw_len);
+
+#define MSG_REMAINING() (msg_end - conn->inCursor)
+
+	/* PolarDB extension: parse LSN if present */
+	conn->polar_has_lsn = false;
+	conn->polar_last_lsn = 0;
+	if (conn->polar_proxy_send_lsn && MSG_REMAINING() >= 8)
+	{
+		char lsn_buf[8];
+		if (pqGetnchar(lsn_buf, 8, conn) == 0)
+		{
+			uint64 lsn;
+			memcpy(&lsn, lsn_buf, 8);
+			lsn = pg_ntoh64(lsn);
+			conn->polar_last_lsn = lsn;
+			conn->polar_has_lsn = true;
+		}
+	}
+
+	/*
+	 * PolarDB extension: parse transaction split info if present.
+	 *
+	 * Marker byte meanings:
+	 *   'x' - splittable: WAL flushed, xids follow
+	 *   'w' - WAL pending: xids follow but replica wait is not safe yet
+	 *   absent/other - not splittable; remaining extension bytes are skipped
+	 */
+	conn->polar_xact_splittable = false;
+	conn->polar_xact_wal_pending = false;
+	if (conn->polar_xact_xids)
+	{
+		free(conn->polar_xact_xids);
+		conn->polar_xact_xids = NULL;
+	}
+	if (conn->polar_proxy_send_xact && MSG_REMAINING() >= 1)
+	{
+		char marker;
+		if (pqGetc(&marker, conn) == 0 && (marker == 'x' || marker == 'w'))
+		{
+			const int remaining = MSG_REMAINING();
+			int len = 0;
+
+			while (len < remaining && conn->inBuffer[conn->inCursor + len] != '\0')
+				len++;
+
+			if (len < remaining)
+			{
+				conn->polar_xact_xids = malloc((size_t) len + 1);
+				if (conn->polar_xact_xids)
+				{
+					memcpy(conn->polar_xact_xids, conn->inBuffer + conn->inCursor, len);
+					conn->polar_xact_xids[len] = '\0';
+					conn->inCursor += len + 1;
+					if (len > 0)
+					{
+						if (marker == 'x')
+							conn->polar_xact_splittable = true;
+						else
+							conn->polar_xact_wal_pending = true;
+					}
+				}
+			}
+		}
+	}
+
+	/*
+	 * Skip any remaining bytes we did not parse.  This handles:
+	 *  - the backend appending xact data the proxy did not request
+	 *  - Future PolarDB protocol extensions
+	 */
+	if (MSG_REMAINING() > 0)
+		conn->inCursor = msg_end;
+
+#undef MSG_REMAINING
+
+	conn->polar_ready_sequence++;
+
 	return 0;
 }
 

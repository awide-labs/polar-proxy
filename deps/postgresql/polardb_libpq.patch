+static int
+psDataRowFrameLenAt(PGconn *conn, int start, int *frame_len)
+{
+	int			msgLength;
+	int			frameEnd;
+	uint32		netlen;
+
+	if (start + 5 > conn->inEnd)
+		return EOF;
+	if (conn->inBuffer[start] != 'D')
+		return 1;
+
+	memcpy(&netlen, conn->inBuffer + start + 1, sizeof(netlen));
+	msgLength = (int) pg_ntoh32(netlen);
+	if (msgLength < 4)
+		return 1;
+	if (msgLength > 30000 && !VALID_LONG_MESSAGE_TYPE('D'))
+		return 1;
+
+	*frame_len = msgLength + 1;
+	frameEnd = start + *frame_len;
+	if (frameEnd > conn->inEnd)
+	{
+		if (frameEnd <= conn->inBufSize)
+			return EOF;
+		return 1;
+	}
+
+	return 0;
+}
+
+#ifdef POLARDB_LIBPQ_ROW_RUN_VALIDATE
+static int
+psValidateDataRowPayloadAt(PGconn *conn, int start, int frame_len)
+{
+	int			bodyStart;
+	int			frameEnd;
+	PGresult   *res;
+	int			nfields;
+	int			tupnfields;
+	int			pos;
+	int			i;
+	uint32		netlen;
+
+	if (conn->result == NULL ||
+		conn->result->resultStatus != PGRES_TUPLES_OK)
+		return 1;
+
+	res = conn->result;
+	nfields = res->numAttributes;
+	bodyStart = start + 5;
+	frameEnd = start + frame_len;
+	pos = bodyStart;
+	if (pos + 2 > frameEnd)
+		return 1;
+
+	tupnfields = (unsigned char) conn->inBuffer[pos] << 8 |
+		(unsigned char) conn->inBuffer[pos + 1];
+	pos += 2;
+	if (tupnfields != nfields)
+		return 1;
+
+	for (i = 0; i < nfields; i++)
+	{
+		int			vlen;
+
+		if (pos + 4 > frameEnd)
+			return 1;
+		memcpy(&netlen, conn->inBuffer + pos, sizeof(netlen));
+		vlen = (int) pg_ntoh32(netlen);
+		pos += 4;
+		if (vlen == -1)
+			continue;
+		if (vlen < 0)
+			return 1;
+		if (pos + vlen > frameEnd)
+			return 1;
+		pos += vlen;
+	}
+
+	return (pos == frameEnd) ? 0 : 1;
+}
+#endif
+
+static int
+psRowRunFrameAt(PGconn *conn, int start, int *frame_len)
+{
+	int			rc;
+
+	rc = psDataRowFrameLenAt(conn, start, frame_len);
+	if (rc != 0)
+		return rc;
+
+#ifdef POLARDB_LIBPQ_ROW_RUN_VALIDATE
+	return psValidateDataRowPayloadAt(conn, start, *frame_len);
+#else
+	return 0;
+#endif
+}
